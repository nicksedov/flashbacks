# =============================================================================
# Flashbacks — local development environment (host-native, no Docker Compose)
# =============================================================================
# Copy this file and adjust the credentials:
#
#     cp .env.example .env
#
# Both the Makefile and scripts/dev.sh load .env and export every variable to
# the services they launch (core, exif, ocr). Integration tests layer the
# tracked `test.env` overlay (test-only overrides, no secrets) on top of this
# file. .env is git-ignored — never commit real secrets.

# --- PostgreSQL -------------------------------------------------------------
# A single database is shared by all microservices (core owns most tables,
# exif owns image_metadata + geolocation_caches).
#
# The IDE container talks to the host Postgres over the Docker network:
#   postgreshost  -> the Postgres container alias used by this project (default)
#   postgres      -> the container/service DNS name
#   172.18.0.1    -> the Docker bridge gateway (host-published 5432)
DB_HOST=postgreshost
DB_PORT=5432
DB_USER=flashbacks
DB_PASSWORD=change-me
DB_NAME=flashbacks
DB_SSLMODE=disable

# --- core service -----------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=5170
# Comma-separated allowed origins, or "*" to allow all
CORS_ORIGINS=*
BOOTSTRAP_LOGIN=admin
BOOTSTRAP_PASSWORD=changeme

# --- inter-service peer URLs (core → exif / ocr) ----------------------------
# Bootstrap/fallback addresses, NOT the primary discovery mechanism. core
# resolves peers through the registry (REGISTRY_URL) and prefers the registered
# instance; these values are used only when:
#   - REGISTRY_URL is empty (registry integration disabled — e.g. running a
#     single service such as `make dev-core` without the registry), or
#   - the registry is unreachable, or the peer has not registered yet
#     (startup race after `make up`).
# If omitted, core falls back to the same localhost defaults, so keep them only
# when exif/ocr listen on different ports on this host. Staging omits them
# deliberately to let discovery stay fully dynamic.
EXIF_SERVICE_URL=http://localhost:5172
OCR_SERVICE_URL=http://localhost:5174

# --- exif service -----------------------------------------------------------
EXIF_HOST=0.0.0.0
EXIF_PORT=5172
EXIF_LOG_LEVEL=info

# --- ocr service ------------------------------------------------------------
OCR_HOST=0.0.0.0
OCR_PORT=5174

# --- pytest OCR integration tests -------------------------------------------
# `make test-ocr-integration` uses OCR_SERVICE_URL (above) as the base URL of
# the running OCR service — no separate variable is needed.

# --- integration tests ------------------------------------------------------
# The HTTP suites (tests/webapp and the OCR pytest run — see
# make test-webapp-integration / make test-ocr-integration) read this file and
# then apply the tracked `test.env` overlay, which only overrides DB_NAME to the
# throwaway "flashbacks-test" database. Never copy this file into test.env.
# Safety: the webapp suite refuses to run when DB_NAME points at the production
# database ("flashbacks").
#
# Provision that database once as the Postgres superuser; the application role
# owns it so the core service can create its schema:
#   CREATE DATABASE "flashbacks-test" OWNER flashbacks;
# The superuser (POSTGRES_SUPERUSER, default "postgres") is only used to enable
# the pgvector extension before the schema boots.

# --- registry service (embedded etcd + config facade) ----------------------
# The registry is the single source of truth for service configuration,
# discovery, and secrets. Services talk to its REST facade, not to etcd.
# REGISTRY_MASTER_KEY must be base64 of exactly 32 bytes. The value below is a
# DEV-ONLY placeholder (32 zero bytes) — replace it in every real environment.
REGISTRY_DATA_DIR=.run/registry-data
REGISTRY_CLIENT_URL=http://127.0.0.1:2379
REGISTRY_PEER_URL=http://127.0.0.1:2380
REGISTRY_HTTP_PORT=5176
REGISTRY_HTTP_ADDR=:5176
REGISTRY_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
REGISTRY_AUTH_ENABLED=false
REGISTRY_ROOT_PASSWORD=
REGISTRY_AUTH_TOKEN=
REGISTRY_TLS_CERT_FILE=
REGISTRY_TLS_KEY_FILE=
REGISTRY_TLS_CA_FILE=

# --- registry client bootstrap (core/exif/ocr) -----------------------------
# Empty REGISTRY_URL disables registry integration and keeps env/default config.
REGISTRY_URL=http://localhost:5176
# SERVICE_NAME and SERVICE_ID are provided per service by scripts/dev.sh; set
# them explicitly when running a service binary directly.
