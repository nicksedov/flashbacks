# PostgreSQL database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=flashbacks
DB_PASSWORD=postgres
DB_NAME=flashbacks

# API server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5170

# CORS - comma-separated allowed origins, or "*" to allow all
CORS_ORIGINS=*

# Authentication configuration
# Bootstrap admin credentials (used only when no users exist in the database)
BOOTSTRAP_LOGIN=admin
BOOTSTRAP_PASSWORD=changeme

# Account creation mode: how user accounts are created
#   admin_only                - self-service registration disabled; admin creates accounts (default)
#   self_service              - self-service registration enabled; accounts active immediately
#   self_service_with_approval - self-service registration enabled; accounts pending admin approval
ACCOUNT_CREATION_MODE=admin_only

# Session configuration
# SESSION_IDLE_HOURS: Session expires after this many hours of inactivity (default: 720 = 30 days)
# SESSION_ABSOLUTE_DAYS: Session expires after this many days regardless of activity (default: 90)
SESSION_IDLE_HOURS=720
SESSION_ABSOLUTE_DAYS=90

# EXIF microservice configuration
# EXIF_SERVICE_URL: URL of the EXIF microservice (default: http://localhost:5172)
EXIF_SERVICE_URL=http://localhost:5172
EXIF_LOG_LEVEL=info

# Faces microservice configuration
# FACES_SERVICE_URL: URL of the faces service (default: http://localhost:5173)
# FACES_BATCH_SIZE: images per analysis request; 1 = one request per photo (default: 8)
# FACES_BATCH_CONCURRENCY: analysis requests in flight, one per faces model session
# (one session per GPU); keep it equal to the GPU count (default: 2)
# FACES_ANALYZE_TIMEOUT: time budget for one batch analysis request (Go duration, default: 300s)
# FACES_CLUSTER_MODE: clustering strategy (default: auto)
#   auto   - ask the vector store for candidates when it can answer kNN queries
#   store  - always ask the vector store (requires pgvector >= 0.7)
#   memory - keep the in-memory all-pairs call (rollback lever)
# FACES_CLUSTER_NEIGHBOURS: candidates per face in the store path (default: 16)
# FACES_CLUSTER_TIMEOUT: budget for one clustering decision and the neighbour
# index build (Go duration, default: 10m — a large gallery needs minutes)
FACES_SERVICE_URL=http://localhost:5173
FACES_BATCH_SIZE=8
FACES_BATCH_CONCURRENCY=2
FACES_ANALYZE_TIMEOUT=300s
FACES_CLUSTER_MODE=auto
FACES_CLUSTER_NEIGHBOURS=16
FACES_CLUSTER_TIMEOUT=10m

# OCR classifier microservice configuration
# OCR_ENABLED: Enable OCR classifier integration (default: true)
# OCR_SERVICE_URL: URL of the OCR classifier service (default: http://localhost:5174)
# OCR_CHECK_INTERVAL: Health check interval in seconds (default: 10)
OCR_ENABLED=true
OCR_SERVICE_URL=http://localhost:5174
OCR_CHECK_INTERVAL=10

# Agent configuration
# AGENT_MAX_CONVERSATION_TOKENS: Maximum tokens per conversation before exhaustion (default: 128000)
# Falls back to this value when model-specific context length is unavailable.
AGENT_MAX_CONVERSATION_TOKENS=128000

# LLM model catalog configuration
# LLM_MODELS_CACHE_TTL: how long a stored provider model catalog stays valid
# before it is re-collected on read (Go duration, default: 24h)
LLM_MODELS_CACHE_TTL=24h
