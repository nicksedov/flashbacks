# =============================================================================
# Flashbacks — integration-test overlay
# =============================================================================
# This file is layered ON TOP of the repository `.env` base profile and must
# contain ONLY the values that differ from it. Never copy the whole `.env`
# here — shared configuration lives in one place (`make env` creates `.env`
# from `.env.example`).
#
# Loaded by:
#   - scripts/dev.sh via FLASHBACKS_ENV_FILE (make test-ocr-integration)
#   - the webapp HTTP integration suite (tests/webapp/integration/support.ts)
#   - Makefile recipes that use LOAD_TEST_ENV
#
# It contains no secrets, so it is tracked by git.

# Target database for the integration suites — a throwaway database that the
# suites truncate, so it must never hold real data. The webapp suite refuses to
# run when this points at the development database ("flashbacks").
DB_NAME=flashbacks-test
